mukhya() {
    x purnank = 5;
    x++;
    x mudraya;       // should print 6

    x--;
    x mudraya;       // should print 5

    y purnank = 10;
    y *= 2;
    y mudraya;       // should print 20

    flag tark = satya;
    flag = !flag;
    flag mudraya;    // should print 0 (asatya)

    nivarta;
}